rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }

    match /users/{uid} { allow read, update, delete: if isOwner(uid) || isAdmin(); allow create: if signedIn() || isAdmin(); }
    match /admins/{uid} { allow read, write: if isAdmin(); }
    match /products/{productId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /categories/{categoryId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /cart/{uid} { allow read, write: if isOwner(uid) || isAdmin(); }
    match /wishlist/{uid} { allow read, write: if isOwner(uid) || isAdmin(); }
    match /orders/{orderId} { allow create: if signedIn(); allow read, update: if isAdmin() || resource.data.userId == request.auth.uid; allow delete: if isAdmin(); }
    match /payments/{paymentId} { allow read: if isAdmin() || resource.data.userId == request.auth.uid; allow write: if isAdmin(); }
    match /reviews/{reviewId} { allow read: if true; allow create: if signedIn(); allow update, delete: if isAdmin() || resource.data.userId == request.auth.uid; }
    match /coupons/{couponId} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{bannerId} { allow read: if true; allow write: if isAdmin(); }
    match /notifications/{notificationId} { allow read, update: if isAdmin() || resource.data.userId == request.auth.uid; allow create, delete: if isAdmin(); }
    match /tracking/{trackingId} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /returns/{returnId} { allow read, create: if signedIn(); allow update, delete: if isAdmin(); }
    match /refunds/{refundId} { allow read: if isAdmin() || resource.data.userId == request.auth.uid; allow write: if isAdmin(); }
    match /settings/{uid} { allow read, write: if isOwner(uid) || isAdmin(); }
    match /analytics/{docId} { allow read, write: if isAdmin(); }
    match /activity_logs/{logId} { allow read, write: if isAdmin(); }
    match /support_tickets/{ticketId} { allow create: if signedIn(); allow read, update: if isAdmin() || resource.data.userId == request.auth.uid; allow delete: if isAdmin(); }
    match /ai_recommendations/{uid} { allow read, write: if isOwner(uid) || isAdmin(); }
  }
}
